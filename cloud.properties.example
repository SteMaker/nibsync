# Built-in OAuth clients for OneDrive and Google Drive (see docs/cloud-setup.md). Optional:
# the ids can also be entered in the app's settings. Copy to cloud.properties (not checked
# in) and fill in; empty values leave the service unavailable unless entered in the app.

# Microsoft Entra app registration: Application (client) ID
onedrive.clientId=

# Google Cloud OAuth client of type "Desktop app" (the PC app); the secret of desktop clients
# is not secret by Google's design
google.desktop.clientId=
google.desktop.clientSecret=

