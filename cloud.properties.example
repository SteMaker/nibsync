# OAuth clients for OneDrive and Google Drive, registered once for the app (see
# docs/cloud-setup.md). Copy to cloud.properties (not checked in) and fill in; empty values
# leave the service unavailable. Google Drive on Android needs no entry here.

# Microsoft Entra app registration: Application (client) ID
onedrive.clientId=

# Google Cloud OAuth client of type "Desktop app" (the PC app); the secret of desktop clients
# is not secret by Google's design
google.desktop.clientId=
google.desktop.clientSecret=

