# OAuth clients for OneDrive and Google Drive (see docs/cloud-setup.md). Copy to
# cloud.properties (not checked in) and fill in; empty values leave the service unavailable.

# Microsoft Entra app registration: Application (client) ID
onedrive.clientId=

# Google Cloud OAuth client of type "Desktop app" (the PC app); the secret of desktop clients
# is not secret by Google's design
google.desktop.clientId=
google.desktop.clientSecret=

# true once the Google Cloud OAuth client of type "Android" (package de.nibsync.app with the
# signing certificate's SHA-1) exists
google.android=false
